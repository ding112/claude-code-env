  "description": "Claude Code 配置切换工具 - 管理多个 API Provider/Profile 并快速切换",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cce": "dist/index.js"
  },
  "files": [
    "dist",
    "webui",
    "README.md",
    "LICENSE"
