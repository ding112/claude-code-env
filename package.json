  "author": "mengzai1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ding112/claude-code-env.git"
  },
  "homepage": "https://github.com/ding112/claude-code-env#readme",
  "bugs": {
    "url": "https://github.com/ding112/claude-code-env/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mengzai1/cce": "^1.0.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "express": "^5.2.1",
    "inquirer": "^8.2.6",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
